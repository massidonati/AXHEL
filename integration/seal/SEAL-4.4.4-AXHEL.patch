+            struct AXHELNTTCacheKey
+            {
+                std::uint64_t degree;
+                std::uint64_t modulus;
+                std::uint64_t root;
+
+                bool operator==(const AXHELNTTCacheKey &other) const noexcept
+                {
+                    return degree == other.degree && modulus == other.modulus && root == other.root;
+                }
+            };
+
+            struct AXHELNTTCacheKeyHash
+            {
+                std::size_t operator()(const AXHELNTTCacheKey &key) const noexcept
+                {
+                    std::size_t seed = std::hash<std::uint64_t>{}(key.degree);
+                    seed ^= std::hash<std::uint64_t>{}(key.modulus) + 0x9e3779b9U + (seed << 6) + (seed >> 2);
+                    seed ^= std::hash<std::uint64_t>{}(key.root) + 0x9e3779b9U + (seed << 6) + (seed >> 2);
+                    return seed;
+                }
+            };
+
+            using AXHELNTTCache = std::unordered_map<
+                AXHELNTTCacheKey, std::shared_ptr<const unipi::axhel::NTT>, AXHELNTTCacheKeyHash>;
+
+            std::shared_ptr<const unipi::axhel::NTT> get_cached_axhel_ntt(
+                std::uint64_t degree, std::uint64_t modulus, std::uint64_t root)
+            {
+                static AXHELNTTCache cache;
+                static std::mutex cache_mutex;
+
+                const AXHELNTTCacheKey key{ degree, modulus, root };
+                std::lock_guard<std::mutex> lock(cache_mutex);
+
+                auto cached = cache.find(key);
+                if (cached != cache.end())
+                {
+                    return cached->second;
+                }
+
+                auto ntt = std::make_shared<const unipi::axhel::NTT>(degree, modulus, root);
+                cache.emplace(key, ntt);
+                return ntt;
+            }
+        } // namespace
+
+        void NTTTables::initialize_axhel_ntt()
+        {
+            // AXHEL regenerates the tables only once for each distinct
+            // (degree, modulus, primitive root) tuple. All NTTTables copies and
+            // all SEALContext instances in the process share the cached object.
+            axhel_ntt_ = get_cached_axhel_ntt(
+                static_cast<std::uint64_t>(coeff_count_), modulus_.value(), root_);
+        }
+#endif
